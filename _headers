# Cloudflare Pages 自定义响应头
# 语法：每一段以「匹配路径」开头，其下为键值对（缩进 1+ 空格）

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://api.github.com; frame-ancestors 'none'

# 静态资源：长期缓存（文件带内容哈希或极少变动）
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 博客 Markdown 源文件：短缓存，便于更新后较快生效
/blog/*
  Cache-Control: public, max-age=3600
